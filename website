                </div>

                <div class="form-group">
                    <label for="emailAddress">Email Address</label>
                    <input type="email" id="emailAddress" placeholder="client@domain.com">
                    <span class="error-message" id="emailError"></span>
                </div>

                <div class="form-group">
                    <label for="inquiryType">Inquiry Category</label>
                    <select id="inquiryType">
                        <option value="">Select Category...</option>
                        <option value="bespoke">Bespoke Trunk Customization</option>
                        <option value="private">Private VIP Salon Appointment</option>
