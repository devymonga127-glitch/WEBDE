    </footer>

    <!-- Interactive JavaScript -->
    <script>
        // Form Validation & Handling
        function handleFormSubmit(event) {
            event.preventDefault();
            
            let isValid = true;
            
            // Elements
            const name = document.getElementById('fullName');
            const email = document.getElementById('emailAddress');
            const category = document.getElementById('inquiryType');
            const message = document.getElementById('message');
            
            // Reset Errors
            document.getElementById('nameError').textContent = '';
            document.getElementById('emailError').textContent = '';
            document.getElementById('categoryError').textContent = '';
            document.getElementById('messageError').textContent = '';
            document.getElementById('formSuccessBanner').style.display = 'none';

            // Validate Name
            if (!name.value.trim()) {
                document.getElementById('nameError').textContent = 'Please enter your full name.';
                isValid = false;
            }

            // Validate Email
            const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!email.value.trim() || !emailPattern.test(email.value)) {
                document.getElementById('emailError').textContent = 'Please provide a valid email address.';
                isValid = false;
            }

            // Validate Category
            if (!category.value) {
                document.getElementById('categoryError').textContent = 'Please select an inquiry category.';
                isValid = false;
            }

            // Validate Message
            if (!message.value.trim()) {
                document.getElementById('messageError').textContent = 'Please provide a brief message.';
                isValid = false;
            }

            if (isValid) {
                document.getElementById('formSuccessBanner').style.display = 'block';
                document.getElementById('conciergeForm').reset();
            }
        }

        // Live Filter/Search Functionality
        function filterContent() {
            const input = document.getElementById('liveSearchInput').value.toLowerCase();
            const items = document.querySelectorAll('.searchable-item');

            items.forEach(item => {
                const text = item.textContent.toLowerCase();
                if (text.includes(input)) {
                    item.style.display = '';
                } else {
                    item.style.display = 'none';
                }
            });
        }

        // Lightbox Gallery Functions
        function openLightbox(imageSrc, captionText) {
            const modal = document.getElementById('lightboxModal');
            const img = document.getElementById('lightboxImg');
            const caption = document.getElementById('lightboxCaption');
            
            modal.style.display = 'flex';
            img.src = imageSrc;
            caption.textContent = captionText;
        }

        function closeLightbox() {
            document.getElementById('lightboxModal').style.display = 'none';
        }

        // Add to Cart Notification Toast
        function triggerCartNotification() {
            const toast = document.getElementById('toastNotification');
            toast.classList.add('show');
            setTimeout(() => {
                toast.classList.remove('show');
            }, 3000);
        }

        // Escape Key Closes Modal
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                closeLightbox();
            }
        });
    </script>
